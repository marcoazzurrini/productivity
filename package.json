{
  "name": "productivity",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @productivity/desktop dev",
    "build": "bun run --filter @productivity/desktop build",
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings && bun run boundaries",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "test:e2e": "bun run --filter @productivity/desktop test:e2e",
    "install-app": "bun run --filter @productivity/desktop install-app"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dependency-cruiser": "^18.7.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "6.0.3",
    "ultracite": "^8.0.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "lefthook"
  ]
}
